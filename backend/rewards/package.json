{
  "name": "@rekey/rewards",
  "version": "0.1.0",
  "description": "Lifeline Rewards engine for ReKey with verifiable points and achievements",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test": "node --experimental-strip-types tests/*",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts"
  },
  "keywords": ["rewards", "rekey", "lifeline", "points", "achievements"],
  "author": "ReKey Team",
  "license": "MIT",
  "dependencies": {
    "@solana/web3.js": "^1.98.4",
    "zod": "^3.22.4",
    "uuid": "^9.0.1",
    "crypto-js": "^4.2.0"
  },
  "devDependencies": {
    "@types/uuid": "^9.0.7",
    "@types/crypto-js": "^4.1.2",
    "@types/node": "^20.10.6",
    "typescript": "~5.7.2",
    "ts-node": "^10.9.2",
    "eslint": "^8.56.0",
    "prettier": "^3.1.1",
    "@types/jest": "^29.5.12",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2"
  }
}
