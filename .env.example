# ReKey environment configuration - PLACEHOLDERS ONLY.
# Copy to .env and fill in real values locally. NEVER commit a real .env.
# The real .env already exists in the harness directory; do not overwrite it.

# ---------------------------------------------------------------------------
# Solana
# ---------------------------------------------------------------------------
# RPC endpoint. Devnet by default. Never point this at mainnet for this build.
SOLANA_RPC_URL=https://api.devnet.solana.com

# The deployed ReKey Anchor program id.
REKEY_PROGRAM_ID=CuNNoYhAJsGNKZzi7NbEZjVTR2T8GUZyNKMN8SUPzRhS

# Which cluster the API and MCP Gateway read from: devnet | localnet | mainnet
# mainnet is blocked unless REKEY_ALLOW_MAINNET=1 is set explicitly.
REKEY_ENV=devnet

# ---------------------------------------------------------------------------
# AI security assistant (OpenAI-compatible endpoint)
# ---------------------------------------------------------------------------
# Any OpenAI-compatible base URL. Falls back to NVIDIA_BASE_URL when unset.
AI_BASE_URL=https://integrate.api.nvidia.com/v1

# API key for the assistant. Falls back to NVIDIA_API_KEY / NVIDIA_NIM_API_KEY.
# Placeholder here - never put a real key in this file.
AI_API_KEY=your-api-key-here

# Model id for the assistant. Falls back to NVIDIA_SAFETY_MODEL.
AI_MODEL=mistralai/mistral-large-4-1t-a52b

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# Port for the application API.
PORT=8787

# Set to 1 to allow mainnet. Intended for a future, audited release only.
REKEY_ALLOW_MAINNET=0
