# ReKey Environment Variables
# This file contains placeholder values for all configuration options.
# Copy to .env and replace with actual values.

# ==========================================================================
# MCP Server Configuration
# ==========================================================================

# MCP server port
MCP_PORT=3001

# MCP server host
MCP_HOST=localhost

# API key for MCP server authentication
# Generate a strong, random key for production
MCP_API_KEY=your-mcp-api-key-here

# Solana RPC URL
SOLANA_RPC_URL=https://api.devnet.solana.com

# ReKey program ID
REKEY_PROGRAM_ID=284Xsc92KLKwKb7gBYAB8CXWc979FHL11tc185UYqcbP

# MCP server transport (http, stdio)
MCP_TRANSPORT=http

# Log level for MCP server (error, warn, info, debug)
MCP_LOG_LEVEL=info

# Audit log file path
AUDIT_LOG_PATH=./logs/audit.log

# ==========================================================================
# AI Provider Configuration
# ==========================================================================

# NVIDIA AI Provider
NVIDIA_API_KEY=your-nvidia-api-key-here
NVIDIA_API_KEY1=your-nvidia-api-key1-here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_SAFETY_MODEL=nvidia/nemotron-3.5-content-safety

# Mistral AI Provider
MISTRAL_API_KEY=your-mistral-api-key-here
MISTRAL_BASE_URL=https://api.mistral.ai/v1

# Minimax AI Provider
MINIMAX_MODEL=moonshotai/kimi-k3.1-pro

# Default AI model
MISTRAL_MODEL=mistralai/mistral-large-4-1t-a52b
KIMI_MODEL=moonshotai/kimi-k3.1-pro

# AI service timeout (milliseconds)
AI_TIMEOUT=60000

# AI service max retries
AI_MAX_RETRIES=3

# ==========================================================================
# Rewards Engine Configuration
# ==========================================================================

# Points for wallet initialization
POINTS_WALLET_INITIALIZATION=100

# Points for policy configuration
POINTS_POLICY_CONFIGURATION=150

# Points per guardian added
POINTS_PER_GUARDIAN=50

# Points for recovery simulation
POINTS_RECOVERY_SIMULATION=25

# Points for security education
POINTS_SECURITY_EDUCATION=100

# Points for documentation contribution
POINTS_DOCUMENTATION=200

# Points for integration contribution
POINTS_INTEGRATION=300

# Maximum points per wallet (anti-Sybil)
MAX_POINTS_PER_WALLET=10000

# Actions per hour rate limit
RATE_LIMIT_ACTIONS_PER_HOUR=10

# Points per hour rate limit
RATE_LIMIT_POINTS_PER_HOUR=500

# ==========================================================================
# Solana Integration Configuration
# ==========================================================================

# Solana commitment level (confirmed, finalized, processed)
SOLANA_COMMITMENT=confirmed

# Solana connection timeout (milliseconds)
SOLANA_TIMEOUT=60000

# Maximum retries for Solana operations
SOLANA_MAX_RETRIES=3

# ==========================================================================
# Session and Authentication
# ==========================================================================

# Session secret for signing session tokens
# Generate with: openssl rand -hex 32
SESSION_SECRET=your-session-secret-here

# Token secret for signing JWT tokens
TOKEN_SECRET=your-token-secret-here

# Session expiry time (milliseconds)
SESSION_EXPIRY_MS=86400000

# Token expiry time (milliseconds)
TOKEN_EXPIRY_MS=900000

# ==========================================================================
# Rate Limiting Configuration
# ==========================================================================

# Requests per window for rate limiting
RATE_LIMIT_REQUESTS=100

# Window size in milliseconds
RATE_LIMIT_WINDOW_MS=60000

# Maximum wait time in milliseconds (0 = no waiting, just reject)
RATE_LIMIT_MAX_WAIT_MS=0

# ==========================================================================
# Security Configuration
# ==========================================================================

# Allowed origins for CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Enable verification requirement for rewards
REWARDS_VERIFICATION_REQUIRED=true

# ==========================================================================
# Logging Configuration
# ==========================================================================

# Enable console logging
AUDIT_CONSOLE=true

# Enable file logging
AUDIT_FILE_LOGGING=true

# Maximum file size for audit logs (bytes)
AUDIT_MAX_FILE_SIZE=10485760

# Maximum number of audit log files to keep
AUDIT_MAX_FILES=5

# ==========================================================================
# Development Configuration
# ==========================================================================

# Enable development mode
NODE_ENV=development

# Use in-memory storage for development
REWARDS_STORAGE_TYPE=memory
